[Unit]
Description=Turntable Web Controller
After=network.target linuxcnc.service
# Wants=, not Requires=: a LinuxCNC crash or restart must not stop this server, and through it
# anything else. The server reconnects on its own (see LinuxCNCBridge.reconnect).
Wants=linuxcnc.service

[Service]
Type=simple
User=turntable
AmbientCapabilities=CAP_NET_BIND_SERVICE
WorkingDirectory=/home/turntable/linuxcnc/configs/turntable
ExecStart=/usr/bin/python3 /home/turntable/linuxcnc/configs/turntable/turntable_server.py
# systemd creates /run/turntable/ owned by User= and removes it on stop. The control socket lives here.
RuntimeDirectory=turntable
RuntimeDirectoryMode=0750
# always, not on-failure: this server must come back whatever way it ended. An explicit
# `systemctl stop` is still respected.
Restart=always
RestartSec=5
# Unbuffered, so every log line reaches the journal even if the process is killed.
Environment=PYTHONUNBUFFERED=1
# systemd restarts the server if it stops sending heartbeats for 60 s (a hung linuxcnc call
# freezes every thread). turntable_server.py sends them; see _watchdog().
WatchdogSec=60
NotifyAccess=main
# Safety net: if the server ever hangs on stop, systemd kills it after 10 s instead of 90 s.
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target